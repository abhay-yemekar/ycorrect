# Get a Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Use a currently available Flash model in Google AI Studio.
# NOTE: gemini-2.5-flash is currently the recommended Flash model, but it is
# scheduled for deprecation on 2026-10-16 (see https://ai.google.dev/gemini-api/docs/models).
# When it sunsets, update this to the next recommended Flash model and test the
# prompts still produce acceptable output. The server falls back to this value
# when GEMINI_MODEL is unset, so leaving the default here keeps the project
# runnable out of the box.
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
